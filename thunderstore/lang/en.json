    { "key": "entry.Toggle/开关.EnableExpShare.name", "value": "Experience Share" },
    { "key": "entry.Toggle/开关.EnableExpShare.description", "value": "Also give part of the experience to the weapon you are not holding." },
    { "key": "entry.Toggle/开关.EnableHealthBar.name", "value": "Enemy Health Bar" },
    { "key": "entry.Toggle/开关.EnableHealthBar.description", "value": "Show a health bar above enemies you are looking at." },
    { "key": "entry.Toggle/开关.EnableHitFeedback.name", "value": "Hit Crosshair" },
    { "key": "entry.Toggle/开关.EnableHitFeedback.description", "value": "Animate the crosshair when a shot lands." },
    { "key": "entry.Toggle/开关.EnableSoundFeedback.name", "value": "Hit Sound" },
    { "key": "entry.Toggle/开关.EnableSoundFeedback.description", "value": "Play a hit sound when a shot lands on an enemy." },
    { "key": "entry.Toggle/开关.EnableDamageMessage.name", "value": "Damage & Kill Message" },
    { "key": "entry.Toggle/开关.EnableDamageMessage.description", "value": "Show damage numbers and Battlefield style kill messages." },
    { "key": "entry.Toggle/开关.EnableDeadUnitCollision.name", "value": "Bullets Pass Through Corpses" },
    { "key": "entry.Toggle/开关.EnableDeadUnitCollision.description", "value": "Let bullets pass through dead bodies instead of being stopped by them." },
    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.name", "value": "Feedback on Corpse Hits" },
    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.description", "value": "Also give hit feedback for shots into a body that was already dead. Off by default, so harvesting organs stays quiet." },
    { "key": "entry.Toggle/开关.EnableLoopDropVFX.name", "value": "Loot Drop VFX" },
    { "key": "entry.Toggle/开关.EnableLoopDropVFX.description", "value": "Mark dropped loot with a light beam coloured by its quality." },
    { "key": "entry.Toggle/开关.EnableDeadProtection.name", "value": "Death Protection" },
    { "key": "entry.Toggle/开关.EnableDeadProtection.description", "value": "Return your weapons through the donation box when you die. Overlaps with the game's own insured items, so it is off by default." },
