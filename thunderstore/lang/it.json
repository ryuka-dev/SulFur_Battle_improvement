    { "key": "plugin.name", "value": "Battle Improvements" },
    { "key": "plugin.description", "value": "Rende più leggibili i combattimenti di SULFUR: segnali di colpo, messaggi di uccisione, fasci per il bottino, barre della salute e altro." },
