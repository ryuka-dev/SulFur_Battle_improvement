    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.name", "value": "Retour sur les cadavres" },
    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.description", "value": "Donne aussi un retour visuel et sonore pour les tirs sur un corps déjà mort. Désactivé par défaut, pour que la récolte d'organes reste silencieuse." },
