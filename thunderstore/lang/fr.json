    { "key": "entry.Toggle/开关.EnableExpShare.description", "value": "Donne aussi une partie de l'expérience à l'arme que vous n'avez pas en main." },
    { "key": "entry.Toggle/开关.EnableHealthBar.name", "value": "Barre de vie des ennemis" },
    { "key": "entry.Toggle/开关.EnableHealthBar.description", "value": "Affiche une barre de vie au-dessus des ennemis que vous regardez." },
    { "key": "entry.Toggle/开关.EnableHitFeedback.name", "value": "Réticule de tir" },
