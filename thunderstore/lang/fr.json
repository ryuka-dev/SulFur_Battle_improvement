{
  "entries": [
    { "key": "plugin.name", "value": "Battle Improvements" },
    { "key": "plugin.description", "value": "Rend les combats de SULFUR plus lisibles : marqueurs de tir, messages d'élimination, faisceaux de butin, barres de vie et plus encore." },
