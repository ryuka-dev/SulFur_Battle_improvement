{
  "entries": [
    { "key": "plugin.name", "value": "Battle Improvements" },
    { "key": "plugin.description", "value": "讓 SULFUR 的戰鬥更清楚：擊中回饋、擊殺訊息、掉落光柱、敵人血條等。" },
    { "key": "section.Toggle/开关", "value": "功能開關" },
    { "key": "section.ExpShare/经验共享", "value": "經驗共享" },
    { "key": "section.Display/显示", "value": "顯示" },
    { "key": "section.Other/其他", "value": "其他" },
    { "key": "entry.Toggle/开关.EnableExpShare.name", "value": "經驗共享" },
    { "key": "entry.Toggle/开关.EnableExpShare.description", "value": "把一部分經驗同時分給你沒拿在手上的那把武器。" },
    { "key": "entry.Toggle/开关.EnableHealthBar.name", "value": "敵人血條" },
    { "key": "entry.Toggle/开关.EnableHealthBar.description", "value": "在你正看著的敵人頭上顯示血條。" },
    { "key": "entry.Toggle/开关.EnableHitFeedback.name", "value": "擊中準心" },
    { "key": "entry.Toggle/开关.EnableHitFeedback.description", "value": "命中時準心會播放回饋動畫。" },
    { "key": "entry.Toggle/开关.EnableSoundFeedback.name", "value": "擊中音效" },
    { "key": "entry.Toggle/开关.EnableSoundFeedback.description", "value": "命中敵人時播放擊中音效。" },
    { "key": "entry.Toggle/开关.EnableDamageMessage.name", "value": "傷害與擊殺訊息" },
    { "key": "entry.Toggle/开关.EnableDamageMessage.description", "value": "顯示傷害數字與戰地風格的擊殺訊息。" },
    { "key": "entry.Toggle/开关.EnableDeadUnitCollision.name", "value": "子彈穿透屍體" },
    { "key": "entry.Toggle/开关.EnableDeadUnitCollision.description", "value": "讓子彈穿過屍體，而不是被屍體擋住。" },
    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.name", "value": "擊中屍體時的回饋" },
    { "key": "entry.Toggle/开关.EnableDeadUnitFeedback.description", "value": "射擊已經死亡的屍體時也給出擊中回饋。預設關閉，以免打器官時一直響。" },
    { "key": "entry.Toggle/开关.EnableLoopDropVFX.name", "value": "掉落特效" },
    { "key": "entry.Toggle/开关.EnableLoopDropVFX.description", "value": "用依品質上色的光柱標示掉落物。" },
    { "key": "entry.Toggle/开关.EnableDeadProtection.name", "value": "死亡保護" },
    { "key": "entry.Toggle/开关.EnableDeadProtection.description", "value": "死亡後可從捐贈箱取回武器。與遊戲本身的保險物品重疊，因此預設關閉。" },
    { "key": "entry.ExpShare/经验共享.Proportion.name", "value": "共享比例" },
    { "key": "entry.ExpShare/经验共享.Proportion.description", "value": "另一把武器能分到多少比例的經驗。" },
    { "key": "entry.Display/显示.HudScale.name", "value": "戰鬥 HUD 大小" },
    { "key": "entry.Display/显示.HudScale.description", "value": "擊中準心、擊殺訊息與傷害數字的大小。它們已會隨螢幕解析度與遊戲本身的 HUD 大小設定縮放，此項會在這之上再乘以這個倍數。擊殺訊息不會放大到超出螢幕。" },
    { "key": "entry.Display/显示.MenuScale.name", "value": "選單大小" },
    { "key": "entry.Display/显示.MenuScale.description", "value": "本 mod 的 F1 選單大小。螢幕高於 1080 像素時已會自動放大，此項會在這之上再乘以這個倍數。選單不會放大到超出螢幕。" },
    { "key": "entry.Other/其他.ReverseMouseScroll.name", "value": "反轉滑鼠滾輪" },
    { "key": "entry.Other/其他.ReverseMouseScroll.description", "value": "反轉切換物品時的滾輪方向。" },
